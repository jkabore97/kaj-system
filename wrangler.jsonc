{
  // Cloudflare Workers static-assets deployment for the Kaj System website.
  // The site is served straight from ./public — everything else in the repo
  // (node_modules, build scripts, README) stays out of the upload, which is
  // why the assets directory is a dedicated folder and NOT the repo root.
  // Docs: https://developers.cloudflare.com/workers/static-assets/
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kaj-system",
  "compatibility_date": "2026-09-06",
  "assets": {
    "directory": "./public",
    // Serve the nearest 404.html (with a 404 status) for unknown paths.
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
